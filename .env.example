# Copia este archivo como .env (en la raíz del repo) y ajusta los valores. No subas .env al repositorio.

# Puerto de la API (que también sirve el ERP en / y el panel del dueño en /dueno/)
PORT=3100

# Carpeta de datos (base SQLite). En el servidor: /mnt/disco-lento/jerusalen
DATA_DIR=./datos
# DB_PATH=./datos/jerusalen-erp.sqlite

# Fecha "de hoy" fija para la demo (los datos demo llegan hasta el 25-11-2026).
# Bórrala cuando cargues datos reales para usar la fecha real de Bolivia.
FECHA_HOY=2026-11-25

# Pon 1 cuando el sitio se sirva por HTTPS (cookie solo por conexión segura)
COOKIE_SEGURA=0

# Duración de la sesión del ERP en días (la del PIN del dueño dura 30 días)
DIAS_SESION=14

# Clave y PIN que usa la semilla demo. CÁMBIALOS antes de usar con datos reales
# (o cambia cada usuario después con: npm run clave -w @jerusalen/api -- correo NuevaClave)
CLAVE_DEMO=jerusalen2026
PIN_DEMO=2580

# 0 = la API no sirve los archivos compilados (si nginx los sirve aparte)
SERVIR_ESTATICOS=1

# ── Datos reales ──
# Con SEMBRAR_DEMO=0, una base vacía NO carga la demo: crea la sucursal «Casa Matriz» y este administrador.
# SEMBRAR_DEMO=0
# ADMIN_EMAIL=nain@jerusalen.bo
# ADMIN_CLAVE=una-clave-larga-y-segura
# ADMIN_NOMBRE=Nain Torrico
